#!/bin/bash
# upgrade_callback：升级完成后
# 职责：修执行位、兜底关闭 remote；配置（VAR_DIR/oc_home）升级自动保留
set +e
LOG_DIR="${TRIM_PKGVAR:-/var/apps/opencode/var}"
APP_DEST="${TRIM_APPDEST:-/var/apps/opencode/target}"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "$LOG_DIR/upgrade.log" 2>&1

echo "[$(date '+%F %T')] === opencode 升级后配置开始（新版本 ${TRIM_NEW_APPVER:-未知}）==="

chmod 755 "$APP_DEST/opencode-linux-x64" "$APP_DEST/opencode-linux-arm64" \
          "$APP_DEST/server/gateway_amd64" "$APP_DEST/server/gateway_arm64" 2>/dev/null || true

_CFG="$LOG_DIR/oc_home/.opencode/config.json"
if [ -f "$_CFG" ]; then
    sed -i 's/"remote"[[:space:]]*:[[:space:]]*true/"remote": false/g' "$_CFG" 2>/dev/null || true
    chmod 600 "$_CFG" 2>/dev/null || true
fi

echo "[$(date '+%F %T')] === opencode 升级后配置完成 ==="
exit 0
