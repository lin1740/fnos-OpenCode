#!/bin/bash
# install_callback：安装完成后执行（不阻塞、不联网拉取任何东西）
# 职责：目录权限、二进制可执行位、首次配置初始化（HOME/配置模板/公网隧道钉死关闭）

LOG_DIR="${TRIM_PKGVAR:-/var/apps/opencode/var}"
APP_DEST="${TRIM_APPDEST:-/var/apps/opencode/target}"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "$LOG_DIR/install.log" 2>&1

echo "[$(date '+%F %T')] === opencode 安装后配置开始 ==="
echo "[$(date '+%F %T')] 运行身份: $(id) ｜ euid=$(id -u)"

# 0) 项目目录：应用数据区内固定位置（文件管理 → 应用文件 → opencode → projects 可见）
PROJECT_DIR="$LOG_DIR/projects"
mkdir -p "$PROJECT_DIR/我的项目" 2>/dev/null || true
if [ ! -f "$PROJECT_DIR/使用说明.txt" ]; then
    cat > "$PROJECT_DIR/使用说明.txt" 2>/dev/null <<'EOT'
OpenCode 项目目录

1. 把项目文件放到本目录（或任意子文件夹）
2. 打开 OpenCode → 添加项目 → 选中对应文件夹
3. 点右上角「+」新建会话即可开始
EOT
fi
chown -R opencode-agent:opencode-agent "$PROJECT_DIR" 2>/dev/null || true
chmod -R u+rwX,go-rwx "$PROJECT_DIR" 2>/dev/null || true
mkdir -p "$LOG_DIR/oc_home" 2>/dev/null || true
echo "$PROJECT_DIR" > "$LOG_DIR/oc_home/workdir" 2>/dev/null || true
echo "$PROJECT_DIR" > "$LOG_DIR/oc_home/managed_dir" 2>/dev/null || true
chown opencode-agent:opencode-agent "$LOG_DIR/oc_home/workdir" "$LOG_DIR/oc_home/managed_dir" 2>/dev/null || true
echo "[$(date '+%F %T')] 项目目录已就绪：$PROJECT_DIR"
echo "[$(date '+%F %T')] APP_DEST=$APP_DEST"
echo "[$(date '+%F %T')] 架构：$(uname -m)"

# 1) 运行期目录
mkdir -p "$LOG_DIR/oc_home/.opencode" 2>/dev/null || true
chmod 700 "$LOG_DIR/oc_home" 2>/dev/null || true

# 1.5) setuid 引导器：按架构放置为 opencode-setup，root 拥有 + 4755
case "$(uname -m)" in
    aarch64|arm64) _setup_src="$APP_DEST/server/opencode-setup_arm64" ;;
    *)             _setup_src="$APP_DEST/server/opencode-setup_amd64" ;;
esac
SETUP_BIN="$APP_DEST/server/opencode-setup"
if [ -f "$_setup_src" ]; then
    cp -f "$_setup_src" "$SETUP_BIN" 2>/dev/null || true
    if chown root:root "$SETUP_BIN" 2>/dev/null && chmod 4755 "$SETUP_BIN" 2>/dev/null && [ -u "$SETUP_BIN" ] && [ -O "$SETUP_BIN" ]; then
        echo "[$(date '+%F %T')] setuid 引导器已就绪（root 属主）：$SETUP_BIN"
    else
        echo "[$(date '+%F %T')] 警告：无法将引导器设为 root 属主（安装身份非 root），setuid 无效。请在 设置→应用 中授权项目文件夹，或用向导自定义目录。"
    fi
fi

# 2) 二进制可执行位（归档可能丢失执行位，双保险）
chmod 755 "$APP_DEST/opencode-linux-x64" "$APP_DEST/opencode-linux-arm64" \
          "$APP_DEST/server/gateway_amd64" "$APP_DEST/server/gateway_arm64" 2>/dev/null || true

# 3) 公网隧道钉死关闭（三保险之一；网关子进程环境变量与 sed 兜底在运行期仍有）
_CFG="$LOG_DIR/oc_home/.opencode/config.json"
if [ ! -f "$_CFG" ]; then
    cat > "$_CFG" <<'JSONEOF'
{
  "remote": false
}
JSONEOF
    echo "[$(date '+%F %T')] 已写入初始配置（remote=false）"
else
    sed -i 's/"remote"[[:space:]]*:[[:space:]]*true/"remote": false/g' "$_CFG" 2>/dev/null || true
    echo "[$(date '+%F %T')] 保留既有配置，已兜底关闭 remote"
fi
chmod 600 "$_CFG" 2>/dev/null || true

# 4) 校验当前架构对应的二进制存在
case "$(uname -m)" in
    aarch64|arm64) _BIN="$APP_DEST/opencode-linux-arm64" ;;
    *)             _BIN="$APP_DEST/opencode-linux-x64" ;;
esac
if [ ! -x "$_BIN" ]; then
    echo "[$(date '+%F %T')] [错误] 当前架构二进制缺失：$_BIN"
    exit 1
fi
echo "[$(date '+%F %T')] 二进制就绪：$_BIN"

echo "[$(date '+%F %T')] === opencode 安装后配置完成 ==="
exit 0

# 收尾：写一份用户可见的诊断报告（文件管理 → 应用文件 → opencode → 安装诊断.txt）
{
    echo "=== OpenCode 安装诊断 ==="
    echo "时间: $(date '+%F %T')"
    echo "架构: $(uname -m)"
    echo "探测到的项目目录: ${PROJECT_DIR:-未设置}"
    echo "TRIM_RUN_UID: ${TRIM_RUN_UID:-（未提供）}"
    echo "/vol1 下的数字用户目录: $(ls /vol1 2>/dev/null | grep -E '^[0-9]+$' | tr '\n' ' ')"
    echo "目录存在: $([ -d "${PROJECT_DIR:-/nonexistent}" ] && echo 是 || echo 否)"
    echo "目录内容: $(ls -a "${PROJECT_DIR:-/nonexistent}" 2>/dev/null | tr '\n' ' ')"
    echo "workdir 文件内容: $(cat "$LOG_DIR/oc_home/workdir" 2>/dev/null || echo 缺失)"
    echo "opencode-agent 能否读项目目录: $(sudo -u opencode-agent ls "$PROJECT_DIR" >/dev/null 2>&1 && echo 能 || echo 不能)"
    echo "opencode-agent 能否写项目目录: $(sudo -u opencode-agent sh -c "touch '$PROJECT_DIR/.t' && rm -f '$PROJECT_DIR/.t'" 2>/dev/null && echo 能 || echo 不能)"
} > "$LOG_DIR/安装诊断.txt" 2>&1
echo "[$(date '+%F %T')] 诊断报告已写入 $LOG_DIR/安装诊断.txt"
exit 0
