#!/bin/bash
# install_init：安装前检查（失败写 $TRIM_TEMP_LOGFILE 并 exit 1 阻止安装）

FEEDBACK_INFO="反馈：https://github.com/anomalyco/opencode"

case "$(uname -m 2>/dev/null)" in
    x86_64|amd64|aarch64|arm64) : ;;
    *)
        {
            echo "本机架构 $(uname -m) 不受支持。opencode 官方仅提供 x86_64 与 arm64 (aarch64) 二进制。$FEEDBACK_INFO"
        } > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
        ;;
esac

# 内存检查（opencode 运行需要约 500MB，留足余量要求 1GB）
_MEM_TOTAL_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
if [ -n "$_MEM_TOTAL_KB" ]; then
    _MEM_TOTAL_MB=$((_MEM_TOTAL_KB / 1024))
    if [ "$_MEM_TOTAL_MB" -lt 1024 ]; then
        {
            echo "内存不足（${_MEM_TOTAL_MB}MB < 1GB），opencode 无法稳定运行。请升级内存或关闭其他应用后重试。$FEEDBACK_INFO"
        } > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi
fi

exit 0
