#!/bin/bash
# uninstall_callback：卸载完成后执行
# 数据去向（卸载向导可选保留/删除，默认全部保留）：
#   应用数据（配置、API Key、会话）：/vol1/@appdata/opencode 与 /vol1/@apphome/opencode
#   项目文件：/vol1/1000/文件/OpenCode（用户数据，默认永不删除）
set +e

LOG_DIR="${TRIM_PKGVAR:-/var/apps/opencode/var}"
APP_DEST="${TRIM_APPDEST:-/var/apps/opencode/target}"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "$LOG_DIR/uninstall.log" 2>&1

# 升级守卫：升级流程不做任何破坏性清理
if [ "$TRIM_APP_STATUS" = "UPGRADE" ] || [ -n "${TRIM_OLD_APPVER:-}" ] || [ -n "${TRIM_TEMP_UPGRADE_FOLDER:-}" ]; then
    echo "[$(date '+%F %T')] 升级流程，跳过清理"
    exit 0
fi

echo "[$(date '+%F %T')] === opencode 卸载清理开始 ==="

# 兜底：停残留进程、清 socket
for _p in $(ps -eo pid,args 2>/dev/null | grep -E 'opencode-linux-(x64|arm64)|gateway_(amd64|arm64)' | grep -F 'opencode' | grep -v grep | awk '{print $1}'); do
    [ "$_p" = "$$" ] && continue
    kill -9 "$_p" 2>/dev/null
done
rm -f "$APP_DEST/app.sock" 2>/dev/null
rm -f "$LOG_DIR"/gateway.pid "$LOG_DIR"/serve.pid "$LOG_DIR"/gateway.lock 2>/dev/null

# 数据清理（向导选项；未出向导的静默卸载一律保留）
case "${wizard_keep_data:-true}" in
    *false*|*delete*)
        echo "[$(date '+%F %T')] 向导选择：删除应用数据（彻底清理）"
        # 应用数据、家目录映射、应用元数据、安装残留一律清除
        rm -rf "/vol1/@appdata/opencode" 2>/dev/null
        rm -rf "/vol1/@apphome/opencode" 2>/dev/null
        rm -rf "/vol1/@appmeta/opencode" 2>/dev/null
        rm -rf "/var/apps/opencode" 2>/dev/null
        rm -rf "/vol1/appcenter-downloads/opencode-"* 2>/dev/null
        echo "[$(date '+%F %T')] 已删除：@appdata/@apphome/@appmeta/var/apps 及下载缓存"
        # 清理应用中心里的授权路径登记（否则会留下指向已删目录的僵尸记录）
        _pd=$(cat "$LOG_DIR/oc_home/workdir" 2>/dev/null | tr -d '\n')
        for _p in "$_pd" "/vol1/@appdata/opencode/projects"; do
            [ -z "$_p" ] && continue
            sudo -u postgres psql -d appcenter -c "delete from app_authorization_path where path='$_p'" >/dev/null 2>&1 || true
            sudo -u postgres psql -d appcenter -c "delete from authorization_path where path='$_p'" >/dev/null 2>&1 || true
        done
        echo "[$(date '+%F %T')] 授权路径登记已清理"
        # 结果自检（写到 /tmp，因为日志目录可能已被删除）
        for _d in /vol1/@appdata/opencode /vol1/@apphome/opencode /vol1/@appmeta/opencode /var/apps/opencode; do
            [ -e "$_d" ] && echo "残留: $_d" >> /tmp/opencode-uninstall-check.log
        done
        ;;
    *)
        echo "[$(date '+%F %T')] 向导选择/默认：保留应用数据（/vol1/@appdata/opencode，含 API Key 与会话）"
        ;;
esac

# 项目文件（用户数据）：仅当向导明确勾选删除才动，默认保留
case "${wizard_keep_projects:-true}" in
    *false*|*delete*)
        _pd=$(cat "$LOG_DIR/oc_home/managed_dir" 2>/dev/null | tr -d '\n')
        [ -z "$_pd" ] && _pd=$(cat "$LOG_DIR/oc_home/workdir" 2>/dev/null | tr -d '\n')
        _mg=$(cat "$LOG_DIR/oc_home/managed_dir" 2>/dev/null | tr -d '\n')
        if [ -n "$_pd" ] && { [ "$_pd" = "$_mg" ] || [ -f "$_pd/.opencode-managed" ]; }; then
            echo "[$(date '+%F %T')] 向导选择：删除项目目录 $_pd（仅删该目录，不影响其他）"
            rm -rf "$_pd" 2>/dev/null
            echo "[$(date '+%F %T')] 项目目录已删除"
        else
            echo "[$(date '+%F %T')] 项目目录无受管标记或未记录，跳过删除（保护用户数据）"
        fi
        ;;
    *)
        echo "[$(date '+%F %T')] 项目文件保留于 /vol1/1000/文件/OpenCode（向导未选择删除）"
        ;;
esac

# 权限回收：移除 opencode-agent 在用户目录上的穿越/访问 ACE（重装时 install 会重新授予）
U=$(id -u opencode-agent 2>/dev/null)
T=/usr/trim/bin/trimacl
if [ -n "$U" ] && [ -x "$T" ]; then
    _i=1
    while : ; do
        _line=$($T /vol1/1000 2>/dev/null | grep -E "^[0-9]+ " | grep "u:$U:" | head -1 | cut -d' ' -f1)
        [ -z "$_line" ] && break
        $T -x2 "$_line" /vol1/1000 >/dev/null 2>&1 || break
        _i=$((_i+1)); [ $_i -gt 5 ] && break
    done
    _i=1
    while : ; do
        _line=$($T "/vol1/1000/文件" 2>/dev/null | grep -E "^[0-9]+ " | grep "u:$U:" | head -1 | cut -d' ' -f1)
        [ -z "$_line" ] && break
        $T -x2 "$_line" "/vol1/1000/文件" >/dev/null 2>&1 || break
        _i=$((_i+1)); [ $_i -gt 5 ] && break
    done
    echo "[$(date '+%F %T')] 已回收 opencode-agent 对用户目录的访问授权（重装时自动重新授予）"
fi

echo "[$(date '+%F %T')] === opencode 卸载清理完成 ==="
exit 0
